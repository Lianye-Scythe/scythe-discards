{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Scythe Discards",
  "description": "__MSG_extensionDescription__",
  "version": "0.3.4",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Scythe Discards",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none';"
  },
  "default_locale": "en"
}
